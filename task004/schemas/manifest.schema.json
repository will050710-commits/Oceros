{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TASK-004 manifest v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "const": "TASK-004"
    },
    "run_id": {
      "type": "string",
      "pattern": "[0-9a-f]{32}"
    },
    "evidence_label": {
      "const": "SYNTHETIC"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "TIMEOUT",
        "CANCELLED",
        "PREFLIGHT_FAILED"
      ]
    },
    "config": {
      "type": "object",
      "properties": {
        "n_ctx": {
          "type": "integer",
          "minimum": 0
        },
        "runtime": {
          "const": "mock"
        },
        "thinking": {
          "const": false
        },
        "max_new_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "timeout_s": {
          "type": "number",
          "minimum": 0
        },
        "startup_timeout_s": {
          "type": "number",
          "minimum": 0
        },
        "sample_interval_s": {
          "type": "number",
          "minimum": 0
        },
        "min_available_ram_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "min_free_disk_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "image_long_edge_px": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_image_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "mock_scenario": {
          "enum": [
            "success",
            "malformed_json",
            "http_error",
            "disconnect",
            "slow",
            "health_failure"
          ]
        },
        "mock_delay_s": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "n_ctx",
        "runtime",
        "thinking",
        "max_new_tokens",
        "timeout_s",
        "startup_timeout_s",
        "sample_interval_s",
        "min_available_ram_bytes",
        "min_free_disk_bytes",
        "image_long_edge_px",
        "max_image_tokens",
        "mock_scenario",
        "mock_delay_s"
      ],
      "additionalProperties": false
    },
    "config_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "mock"
        },
        "python_version": {
          "type": "string"
        },
        "psutil_version": {
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "phase_timers_supported": {
          "const": false
        },
        "streaming_supported": {
          "const": false
        }
      },
      "required": [
        "kind",
        "python_version",
        "psutil_version",
        "os",
        "phase_timers_supported",
        "streaming_supported"
      ],
      "additionalProperties": false
    },
    "decoding": {
      "type": "object",
      "properties": {
        "temperature": {
          "const": 0
        },
        "seed": {
          "const": 1729
        },
        "n": {
          "const": 1
        },
        "thinking": {
          "const": false
        }
      },
      "required": [
        "temperature",
        "seed",
        "n",
        "thinking"
      ],
      "additionalProperties": false
    },
    "preflight": {
      "type": "object",
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "enum": [
                  "available_ram",
                  "free_disk",
                  "output_path"
                ]
              },
              "passed": {
                "type": "boolean"
              },
              "measured_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "required_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "source": {
                "type": "string"
              },
              "unavailable_reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "name",
              "passed"
            ],
            "additionalProperties": false
          }
        },
        "available_ram_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "free_disk_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "system_commit": {
          "type": "object",
          "properties": {
            "total_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "limit_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "available_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "source": {
              "type": [
                "string",
                "null"
              ]
            },
            "unavailable_reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "total_bytes",
            "limit_bytes",
            "available_bytes",
            "source",
            "unavailable_reason"
          ],
          "additionalProperties": false
        },
        "observed_at_utc": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "measurement_scope": {
          "const": "CURRENT_HOST"
        }
      },
      "required": [
        "ready",
        "checks",
        "available_ram_bytes",
        "free_disk_bytes",
        "system_commit",
        "observed_at_utc",
        "platform",
        "measurement_scope"
      ],
      "additionalProperties": false
    },
    "input_provenance": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "MATCH",
            "UNVERIFIED"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "expected_sha256": {
                "type": "string",
                "pattern": "[0-9a-f]{64}"
              },
              "actual_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "[0-9a-f]{64}"
              },
              "integrity": {
                "enum": [
                  "MATCH",
                  "UNVERIFIED"
                ]
              }
            },
            "required": [
              "file",
              "expected_sha256",
              "actual_sha256",
              "integrity"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "sources"
      ],
      "additionalProperties": false
    },
    "hardware_reference": {
      "type": "null"
    },
    "dataset_manifest_hash": {
      "type": "null"
    },
    "benchmark_status": {
      "const": "NOT_RUN"
    },
    "external_model_api_calls": {
      "const": 0
    },
    "metric_unavailability": {
      "type": "object",
      "properties": {
        "ttft_s": {
          "type": "string"
        },
        "prefill_tokens_s": {
          "type": "string"
        },
        "decode_tokens_s": {
          "type": "string"
        }
      },
      "required": [
        "ttft_s",
        "prefill_tokens_s",
        "decode_tokens_s"
      ],
      "additionalProperties": false
    },
    "results": {
      "type": "object",
      "properties": {
        "file": {
          "const": "runs.jsonl"
        },
        "sha256": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "records": {
          "const": 1
        }
      },
      "required": [
        "file",
        "sha256",
        "records"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "run_id",
    "evidence_label",
    "status",
    "config",
    "config_sha256",
    "runtime",
    "decoding",
    "preflight",
    "input_provenance",
    "hardware_reference",
    "dataset_manifest_hash",
    "benchmark_status",
    "external_model_api_calls",
    "metric_unavailability",
    "results"
  ],
  "additionalProperties": false
}
